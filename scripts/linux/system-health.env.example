# system-health.env — Configuración para system-health.sh
# Copiar a .env y completar con los valores del cliente:
#   cp system-health.env.example .env
#   chmod 600 .env

SUPABASE_URL="https://REEMPLAZAR.supabase.co"
SUPABASE_ANON_KEY="REEMPLAZAR_CON_ANON_KEY"
INGEST_SECRET="REEMPLAZAR_CON_INGEST_SECRET"
SERVICE_ID="REEMPLAZAR_CON_SERVICE_ID_DEL_SERVICIO"

# Uptime Kuma — Push Monitor (opcional)
# Crear un monitor tipo "Push" en Kuma y pegar aquí la URL base (sin parámetros).
# Si está vacío, el script no pinga Kuma. Sin mensajes de error.
# Ejemplo: https://kuma.midominio.com/api/push/AbCdEfGhIj
KUMA_PUSH_URL=""

# Opcional: ruta del log local (default: mismo directorio que el script)
# LOG_FILE="/var/log/system-health.log"

# Docker — containers a ignorar (separados por coma, sin espacios)
# Útil para containers que siempre están detenidos por diseño (ej: jobs one-shot)
# DOCKER_IGNORE="mi-container-pausado,otro-container"

# Discos adicionales a monitorear (separados por espacio)
# DISK_MOUNTS="/mnt/datos /mnt/backup"

# Port checks — hasta 20 puertos
# PORT_1_NAME="Web"
# PORT_1_HOST="localhost"
# PORT_1_PORT="80"
# PORT_2_NAME="Base de datos"
# PORT_2_HOST="localhost"
# PORT_2_PORT="5432"

# DB checks — hasta 10 bases de datos con heartbeat separado
# Cada DB usa su propio SERVICE_ID e INGEST_SECRET del Service Catalog
# DB_1_NAME="PostgreSQL Principal"
# DB_1_HOST="localhost"
# DB_1_PORT="5432"
# DB_1_TYPE="postgresql"
# DB_1_SERVICE_ID="UUID-DEL-SERVICIO-DB"
# DB_1_INGEST_SECRET="INGEST_SECRET_DEL_SERVICIO_DB"
