# Mapeo nombre de log → service_id en Supabase
# El nombre es el archivo sin .log (ej: RegionalSur.log → RegionalSur)
# El service_id lo encontrás en la plataforma o con:
#   select id, name from services;

RegionalSur=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RegionalNorte=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OtroCliente=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

