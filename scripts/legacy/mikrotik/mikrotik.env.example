# Configuración compartida para mikrotik-heartbeat.sh e ingest-telemetry.py
# Copiar a /etc/mikrotik-ingest.env o scripts/mikrotik/.env

SUPABASE_URL="https://REEMPLAZAR.supabase.co"
SUPABASE_ANON_KEY="eyJ..."        # clave anon (heartbeat)
SUPABASE_SERVICE_KEY="eyJ..."     # clave service_role (telemetría histórica)
INGEST_SECRET="REEMPLAZAR"        # mismo secreto del servicio en la plataforma

# Directorio donde están los *.log de cada router
MIKROTIK_LOG_DIR="/srv/network-monitor/network-monitor/historial"
MIKROTIK_STATE_DIR="/srv/scripts/mikrotik/state"
