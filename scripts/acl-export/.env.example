# acl-export — Configuración
# Copiar a .env y completar:
#   cp .env.example .env && chmod 600 .env

# Supabase — usar la SERVICE ROLE KEY (no la anon key), necesita leer todas las filas
SUPABASE_URL="https://PROYECTO.supabase.co"
SUPABASE_SERVICE_KEY="REEMPLAZAR_CON_SERVICE_ROLE_KEY"

# Carpeta compartida con el contenedor de onboarding (montar el mismo volumen en ambos)
OUTPUT_DIR="/data/acl-pending"

# Archivo de estado local (registra qué revisiones ya fueron exportadas)
STATE_FILE="/data/acl-export-state.json"

# Log local
LOG_FILE="/var/log/acl-export.log"
